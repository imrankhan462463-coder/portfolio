# -----------------------------------------------------------------------------
# IMRAN.DEV — environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# -----------------------------------------------------------------------------

# Contact recipient (falls back to data/profile.json when empty)
CONTACT_TO=imransikdar462@gmail.com

# SMTP delivery. Required in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# ssl | tls | none
SMTP_SECURE=tls
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=IMRAN.DEV
SMTP_TIMEOUT=20

# Local development only: writes messages to storage/contact.log and skips SMTP.
CONTACT_DEV_MODE=true

# Admin password hash (generate with: php tools/hash-password.php "your-password")
ADMIN_PASSWORD_HASH=

# Optional absolute site URL used in canonical/Open Graph tags.
SITE_URL=https://imran.dev
